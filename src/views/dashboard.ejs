<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ayrexx — Control Panel</title><link rel="stylesheet" href="/static/style.css"></head><body>
<header class="topbar"><a class="brand" href="/dashboard"><span class="brand-mark">♛<b>AX</b></span><span><strong>AYRE<span>XX</span></strong><small>Discord Bot • Control Panel</small></span></a><form class="guild-picker" method="get" action="/dashboard"><span class="discord-mark">◉</span><select name="guild" aria-label="اختار السيرفر" onchange="this.form.submit()"><% if(!guilds.length){ %><option>اختار السيرفر</option><% } else { guilds.forEach(g=>{ %><option value="<%= g.id %>" <%= g.id===selected?'selected':'' %>><%= g.name %></option><% }) } %></select></form><div class="user-chip"><span class="avatar">♜</span><span><b><%= user.username %></b><small><%= isOwner ? "♛ Bot Owner" : "Server Admin" %></small></span><% if(isOwner){ %><a href="/owner">لوحة المالك</a><% } %><a href="/logout">خروج</a></div></header>
<div class="layout"><aside class="sidebar"><nav><a class="active" href="/dashboard">⌂ <span>الرئيسية</span></a><a href="#server">♟ <span>إدارة السيرفر</span><i>⌄</i></a><a href="#commands">» <span>الأوامر</span><i>⌄</i></a><a href="#economy">▤ <span>الاقتصاد</span><i>⌄</i></a><a href="#levels">★ <span>المستويات</span><i>⌄</i></a><a href="#roles">♛ <span>الرتب التلقائية</span><i>⌄</i></a><a href="#tickets">◆ <span>التذاكر</span><i>⌄</i></a><a href="#events">▦ <span>الفعاليات</span><i>⌄</i></a><a href="#logs">▤ <span>السجلات</span><i>⌄</i></a><a href="#security">⬟ <span>الحماية</span><i>⌄</i></a><a href="#settings">⚙ <span>إعدادات البوت</span><i>⌄</i></a><a href="#website">◎ <span>الموقع</span><i>⌄</i></a><a href="#support">◉ <span>الدعم والمساعدة</span></a></nav><div class="sidebar-credit"><div>♛</div><b>تم تطوير البوت بواسطة</b><strong>ISANO</strong><small>All Rights Reserved © 2026</small></div></aside>
<main class="content"><section class="hero"><div class="hero-logo">AX<small>♛</small></div><div class="hero-copy"><h1>Ayre<span>xx</span></h1><h2>Discord Bot <em>v1.0.0</em></h2><p>Powerful ・ Secure ・ Easy to Use</p><div class="rights"><b>ISANO</b> : حقوق التطوير والتصميم</div></div><div class="hero-tag">أكثر من مجرد بوت ..<strong>Ayrexx</strong></div></section>
<section class="stats"><article class="stat"><span>▤</span><div><b><%= guilds.length %></b><small>السيرفرات المرتبطة</small></div></article><article class="stat"><span>♟</span><div><b>—</b><small>الأعضاء الإجماليين</small></div></article><article class="stat"><span>›_</span><div><b>4</b><small>الأوامر المتاحة مبدئيًا</small></div></article><article class="stat"><span class="green">◴</span><div><b>—</b><small>حالة التشغيل</small></div></article></section>
<div class="main-grid"><section class="card updates"><h3><span class="red">✦</span> آخر التحديثات</h3><div class="update"><span>▣</span><div><b>إطلاق لوحة تحكم Ayrexx</b><small>تم تجهيز النسخة الأساسية للوحة التحكم</small></div><time>2026-10-30</time></div><div class="update"><span>▤</span><div><b>إعدادات السيرفر</b><small>إعداد قناة الترحيب والسجلات لكل سيرفر</small></div><time>جديد</time></div><div class="update"><span>⬟</span><div><b>تسجيل الدخول الآمن</b><small>الدخول باستخدام Discord OAuth2</small></div><time>جديد</time></div><div class="update"><span>⚙</span><div><b>تطوير لوحة التحكم</b><small>واجهة متجاوبة للموبايل والكمبيوتر</small></div><time>جديد</time></div></section>
<section class="card server-settings" id="server"><h3><span class="red">⚑</span> إعدادات السيرفر</h3><% if(!guilds.length){ %><div class="empty"><b>مفيش سيرفرات متاحة</b><p>ادخل بحساب عنده صلاحية Manage Server أو Administrator في السيرفر.</p><a class="btn" href="<%= inviteUrl %>" target="_blank" rel="noreferrer">إضافة البوت إلى سيرفر</a></div><% } else { %><div class="selected-server"><span class="server-icon">AX</span><div><b><%= guilds.find(g=>g.id===selected)?.name || 'سيرفرك' %></b><small>إعدادات السيرفر الحالي</small></div><span class="online">● حسابك لديه صلاحية الإدارة</span></div><div class="bot-install"><% if(botAdded){ %><b class="online">● البوت موجود في السيرفر</b><% } else { %><b class="red">البوت غير موجود في السيرفر</b><a class="btn" href="<%= inviteUrl %>" target="_blank" rel="noreferrer">＋ إضافة Ayrexx إلى السيرفر</a><% } %></div><div class="shortcut-grid"><a href="#welcome">♟ تخصيص الترحيب</a><a href="#commands">‹/› إعدادات الأوامر</a><a href="#roles">♛ إعدادات الرتب</a><a href="#security">⬟ إعدادات الحماية</a><a href="#economy">▤ إعدادات الاقتصاد</a><a href="#tickets">◆ إعدادات التذاكر</a></div><form method="post" action="/settings" class="settings" id="settings"><input type="hidden" name="guildId" value="<%= selected %>"><h4 id="welcome">إعدادات البوت والأوامر</h4><label>بادئة أوامر البوت<input name="prefix" maxlength="5" value="<%= settings.prefix || '!' %>" placeholder="!"><small>مثال: !ping أو ?server — البادئة تُحفظ لكل سيرفر.</small></label><label>معرّف قناة الترحيب<input name="welcomeChannel" value="<%= settings?.welcomeChannel||'' %>" placeholder="ID قناة الترحيب"></label><label>رسالة الترحيب<textarea name="welcomeMessage"><%= settings?.welcomeMessage||'Welcome {user} to {server}!' %></textarea><small>استخدم {user} لمنشن العضو و {server} لاسم السيرفر.</small></label><label id="logs">معرّف قناة السجلات<input name="logsChannel" value="<%= settings?.logsChannel||'' %>" placeholder="اختياري"></label><label class="check" id="security"><input type="checkbox" name="antiSpam" <%= settings?.antiSpam?'checked':'' %>> تفعيل مكافحة السبام <small>(يراقب تكرار الرسائل ويحاول حذفها وعمل Timeout عند توافر الصلاحيات)</small></label><button class="btn" type="submit">حفظ الإعدادات　▣</button><% if(saved){ %><p class="online">تم حفظ الإعدادات بنجاح.</p><% } %></form><% } %></section></div>
<section class="bottom-banner"><span>♛</span><div><b>معًا نبني سيرفرات أقوى</b><small>Ayrexx هو أكثر من مجرد بوت.. إنه شريكك في إدارة سيرفرك.</small></div><a href="https://discord.com" target="_blank" rel="noreferrer">انضم إلى مجتمع Ayrexx　➜</a></section><footer>Ayrexx © 2026　|　All rights reserved to <b>ISANO</b><span>الدعم　 |　 سياسة الخصوصية　 |　 الشروط والأحكام</span></footer></main>
<aside class="rightbar"><section class="card"><h3><span class="red">ϟ</span> الأوامر السريعة</h3><div class="quick"><b>▣</b><code>/ping</code><small>فحص استجابة البوت</small><i>›</i></div><div class="quick"><b>♟</b><code>/server</code><small>معلومات السيرفر</small><i>›</i></div><div class="quick"><b>⚑</b><code>/warn</code><small>تحذير عضو</small><i>›</i></div><div class="quick"><b>▤</b><code>/clear</code><small>مسح الرسائل</small><i>›</i></div><small class="muted">الأوامر المعروضة حاليًا هي الأوامر المبرمجة في النسخة الأساسية.</small></section><section class="card bot-info"><h3><span class="red">ⓘ</span> معلومات البوت</h3><div><span>اسم البوت</span><b>Ayrexx</b></div><div><span>المطور</span><b>ISANO</b></div><div><span>الإصدار</span><b>v1.0.0</b></div><div><span>لغة البرمجة</span><b>Node.js</b></div><div><span>المكتبة</span><b>Discord.js</b></div><div class="status"><span>●</span> حالة الاتصال تعتمد على تشغيل البوت</div></section></aside></div></body></html>