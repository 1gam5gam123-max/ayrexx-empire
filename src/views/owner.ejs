<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>AYREXX — OWNER CORE</title><link rel="stylesheet" href="/static/style.css">
<style>
:root{--r:#ff2347;--bg:#07080d;--panel:#10121b;--line:#282b37;--muted:#929bad}
body{background:radial-gradient(ellipse at 50% -18%,#571023 0,transparent 42%),#07080d;color:#f5f6fb;font-family:Arial,Tahoma,sans-serif}
.owner-shell{max-width:1250px;margin:0 auto;padding:28px 22px}.owner-top{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:22px 25px;border:1px solid #632039;border-radius:18px;background:linear-gradient(110deg,#1c0911,#10121b 60%,#190914);box-shadow:0 18px 55px #0008;position:relative;overflow:hidden}
.owner-top:after{content:"";position:absolute;width:260px;height:260px;border:1px solid #ff234722;border-radius:50%;left:-70px;top:-130px;box-shadow:0 0 0 24px #ff23470a,0 0 0 50px #ff234708}
.owner-brand{display:flex;align-items:center;gap:16px;z-index:1}.crown{width:68px;height:68px;border-radius:18px;display:grid;place-items:center;background:linear-gradient(145deg,#ff3154,#8f0926);font-size:32px;box-shadow:0 0 28px #f0183844}.owner-brand h1{margin:0;font-size:26px;letter-spacing:1px}.owner-brand h1 span{color:var(--r)}.owner-brand p{margin:7px 0 0;color:#aeb4c4;font-size:12px}.owner-badge{border:1px solid #a72a46;background:#290d19;color:#ff91a4;padding:10px 15px;border-radius:30px;font-size:12px;z-index:1;white-space:nowrap}
.owner-actions{display:flex;gap:9px;margin-top:16px}.owner-btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;background:linear-gradient(110deg,#f51b3b,#a80a27);color:#fff;border:0;border-radius:10px;padding:11px 16px;font-weight:bold;cursor:pointer}.owner-btn.ghost{background:#141722;border:1px solid #343847;color:#dce1ec}
.owner-welcome{margin:20px 0;display:flex;align-items:center;justify-content:space-between;gap:15px}.owner-welcome h2{font-size:20px;margin:0}.owner-welcome p{color:var(--muted);font-size:12px;margin:6px 0 0}.owner-grid{display:grid;grid-template-columns:1fr 1fr;gap:17px}.owner-card{background:linear-gradient(145deg,#11141e,#0b0d14);border:1px solid var(--line);border-radius:16px;padding:21px;min-width:0;box-shadow:0 10px 30px #0003}.owner-card.full{grid-column:1/-1}.owner-card h3{margin:0 0 8px;font-size:17px}.owner-card .sub{color:var(--muted);font-size:12px;line-height:1.7;margin:0 0 18px}.owner-icon{color:#ff4260;margin-left:8px}
.owner-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.owner-form label{display:flex;flex-direction:column;gap:7px;color:#dce1ec;font-size:12px}.owner-form input,.owner-form select{width:100%;min-width:0;background:#080a10;color:#fff;border:1px solid #343a49;border-radius:9px;padding:12px;font:inherit;outline:none}.owner-form input:focus,.owner-form select:focus{border-color:#ef3151;box-shadow:0 0 0 3px #ef31511a}.owner-form button{grid-column:1/-1}.owner-form .wide{grid-column:1/-1}
.balance{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 17px;margin:17px 0;border:1px solid #5c2437;border-radius:12px;background:linear-gradient(100deg,#250c17,#11131c)}.balance small{display:block;color:#aeb4c4;font-size:11px}.balance strong{display:block;color:#ff5872;font-size:27px;margin-top:5px}.coin{font-size:29px}
.notice{padding:13px 15px;border-radius:10px;background:#10271e;border:1px solid #245b40;color:#8ff0b7;margin:16px 0}.notice.error{background:#2a1018;border-color:#68263a;color:#ff9bad}
.table-wrap{overflow-x:auto}table.history{width:100%;border-collapse:collapse;min-width:620px} .history th,.history td{padding:12px 10px;text-align:right;border-bottom:1px solid #262b36;font-size:12px}.history th{color:#ff8498;font-weight:600;background:#15101a}.history td{color:#d5d9e3}.history tr:last-child td{border:0}.empty-state{padding:18px;text-align:center;color:var(--muted);border:1px dashed #343947;border-radius:10px}
.owner-foot{text-align:center;color:#70798a;font-size:11px;padding:24px 0 8px}.owner-foot b{color:#ff4562}
@media(max-width:800px){.owner-grid{grid-template-columns:1fr}.owner-card.full{grid-column:auto}.owner-top{align-items:flex-start;flex-direction:column}.owner-form{grid-template-columns:1fr}.owner-form button,.owner-form .wide{grid-column:auto}.owner-shell{padding:14px}.owner-brand h1{font-size:21px}}
</style></head>
<body><main class="owner-shell">
<header class="owner-top"><div class="owner-brand"><div class="crown">♛</div><div><h1>AYRE<span>XX</span> / OWNER CORE</h1><p>PRIVATE CONTROL CENTER · ISANO</p></div></div><div class="owner-badge">✦ OWNER ACCESS VERIFIED</div></header>
<div class="owner-actions"><a class="owner-btn ghost" href="/dashboard">← لوحة التحكم</a><a class="owner-btn ghost" href="/logout">تسجيل الخروج</a></div>
<section class="owner-welcome"><div><h2>مركز التحكم الخاص بالمالك</h2><p>أهلاً <b><%= user.username %></b> — من هنا تدير اقتصاد وإعدادات Ayrexx.</p></div><span class="owner-badge">♛ ROOT OWNER</span></section>
<% if(done){ %><div class="notice">✓ تم تنفيذ العملية وحفظها.</div><% } %><% if(error){ %><div class="notice error"><%= error %></div><% } %>
<div class="owner-grid">
<section class="owner-card"><h3><span class="owner-icon">◈</span>إدارة أرصدة الأعضاء</h3><p class="sub">ابحث عن عضو داخل سيرفر، اعرض رصيده، ثم أضف أو اخصم أو عيّن العملات. كل حركة تُسجل في سجل المراجعة.</p>
<form class="owner-form" method="get" action="/owner"><label>معرّف السيرفر Server ID<input name="guildId" required pattern="[0-9]{17,20}" value="<%= guildId %>" placeholder="17–20 رقم"></label><label>معرّف العضو User ID<input name="userId" required pattern="[0-9]{17,20}" value="<%= userId %>" placeholder="17–20 رقم"></label><button class="owner-btn" type="submit">بحث عن الحساب ←</button></form>
<% if(wallet){ %><div class="balance"><div><small>الرصيد الحالي للعضو</small><strong><%= wallet.balance.toLocaleString('en-US') %></strong><small>AYREXX COINS</small></div><div class="coin">◉</div></div>
<form class="owner-form" method="post" action="/owner/currency"><input type="hidden" name="guildId" value="<%= guildId %>"><input type="hidden" name="userId" value="<%= userId %>"><label>نوع العملية<select name="action" required><option value="add">＋ إضافة عملات</option><option value="remove">− خصم عملات</option><option value="set">＝ تعيين الرصيد</option></select></label><label>عدد العملات<input type="number" name="amount" min="0" max="1000000000000" step="1" required placeholder="مثال: 5000"></label><label class="wide">ملاحظة العملية<input name="note" maxlength="250" placeholder="سبب التعديل (اختياري)"></label><button class="owner-btn" type="submit">تأكيد العملية وحفظها</button></form><% } %>
</section>
<section class="owner-card"><h3><span class="owner-icon">⚙</span>تحكم السيرفرات</h3><p class="sub">عدّل إعدادات Ayrexx لأي سيرفر باستخدام Server ID، حتى لو لم يظهر ضمن قائمة سيرفرات حسابك.</p>
<form class="owner-form" method="post" action="/owner/server-settings"><label class="wide">معرّف السيرفر Server ID<input name="guildId" required pattern="[0-9]{17,20}" value="<%= guildId %>" placeholder="أدخل Server ID"></label><label>بادئة الأوامر Prefix<input name="prefix" maxlength="5" value="!" placeholder="!"></label><label>نظام مكافحة السبام<select name="antiSpam"><option value="on">مفعّل</option><option value="off">متوقف</option></select></label><button class="owner-btn" type="submit">حفظ إعدادات السيرفر</button></form>
<div class="notice" style="margin-top:18px">ملاحظة: التحكم هنا يخص إعدادات Ayrexx الداخلية، وليس تغيير بيانات Discord أو ملكية السيرفر.</div>
</section>
<% if(wallet){ %><section class="owner-card full"><h3><span class="owner-icon">▤</span>سجل العمليات المالية</h3><p class="sub">آخر 20 حركة مسجلة على حساب العضو المحدد.</p><% if(history.length){ %><div class="table-wrap"><table class="history"><thead><tr><th>التاريخ</th><th>العملية</th><th>القيمة</th><th>قبل</th><th>بعد</th><th>بواسطة</th></tr></thead><tbody><% history.forEach(x=>{ %><tr><td><%= new Date(x.createdAt).toLocaleString('ar-EG') %></td><td><%= x.action==='add'?'إضافة':x.action==='remove'?'خصم':'تعيين' %></td><td><%= x.amount.toLocaleString('en-US') %></td><td><%= x.before.toLocaleString('en-US') %></td><td><%= x.after.toLocaleString('en-US') %></td><td><%= x.actorId %></td></tr><% }) %></tbody></table></div><% } else { %><div class="empty-state">لا توجد عمليات مسجلة لهذا العضو حتى الآن.</div><% } %></section><% } %>
</div><footer class="owner-foot">AYREXX OWNER CORE <b>• ISANO</b> · PRIVATE ACCESS</footer>
</main></body></html>